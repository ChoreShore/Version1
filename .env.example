# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-public-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# External APIs
RAPIDAPI_KEY=your-rapidapi-key-here

# Email (Resend)
RESEND_API_KEY=your-resend-api-key

# Platform Settings
PLATFORM_FEE_PERCENTAGE=15

# Didit Identity Verification (UniLink URL from Console > Workflow > Copy Link)
DIDIT_UNILINK_URL=https://verify.didit.me/u/YOUR_WORKFLOW_ID_BASE64

# Redis Configuration for Distributed Rate Limiting
# Required for production deployments with multiple server instances
# Format: redis://[password@]host:port/db
# Example: redis://localhost:6379/0 or redis://:password@redis.example.com:6379/0
REDIS_URL=redis://localhost:6379/0

# CSRF Protection
# Allowed origin for CSRF protection (e.g., https://yourdomain.com)
# If not set, will use the request host
ALLOWED_ORIGIN=https://localhost:3000

# Alternative: Use REDIS_HOST if you need more control
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Cypress E2E Test Credentials (prefixed with CYPRESS_ so Cypress auto-maps them)
# CYPRESS_TEST_EMAIL=your-test-email@example.com
# CYPRESS_TEST_PASSWORD=your-test-password
#
# Optional worker-specific accounts for role-based tests:
# CYPRESS_TEST_WORKER_UNVERIFIED_EMAIL=unverified-worker@example.com
# CYPRESS_TEST_WORKER_UNVERIFIED_PASSWORD=password
# CYPRESS_TEST_WORKER_VERIFIED_EMAIL=verified-worker@example.com
# CYPRESS_TEST_WORKER_VERIFIED_PASSWORD=password
